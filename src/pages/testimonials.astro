---
// Every client review in one place, plus the NiceJob review carousel.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Review from '../components/Review.astro';
import Icon from '../components/Icon.astro';
import { firm, avvoProfile } from '../site';
import { reviews } from '../data/reviews';
---
<Base title="Client Testimonials" description={`Client reviews of ${firm.name} and Peter A. Romero, from overtime and unpaid wage cases to discrimination, retaliation and severance negotiations.`}>
  <PageHero
    title="Client Testimonials"
    eyebrow="Client reviews"
    crumbs={[{ label: 'Home', href: '/' }]}
    lede="What clients, and even a former opponent, say about working with Peter Romero and our firm."
  />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Google reviews</p>
        <h2>Recent reviews from our clients.</h2>
      </div>
      <div class="nj-carousel"></div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap reviews">
      <div class="section-head reviews__head">
        <div>
          <p class="eyebrow">Avvo reviews</p>
          <h2>In their own words.</h2>
        </div>
        <a class="reviews__link" href={avvoProfile} target="_blank" rel="noopener">See them on Avvo ↗</a>
      </div>
      <div class="reviews__list">
        {reviews.map((r) => <Review title={r.title} quote={r.quote} name={r.name} detail={r.detail} link={false} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta">
      <div>
        <h2>Ready to talk about your case?</h2>
        <p>The first consultation is free. Tell us what happened at work and find out what your options are.</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={firm.phoneHref}><Icon name="phone" /> Call {firm.phone}</a>
        <a class="btn btn--ghost" href="/contact-us/">Send us a message</a>
      </div>
    </div>
  </section>

  <!-- NiceJob script: fills in the .nj-carousel above. -->
  <script is:inline type="text/javascript" src="https://cdn.nicejob.co/js/sdk.min.js?id=fdaf6f90-b56b-4b97-b05a-8d3b0e5f8f0f" defer></script>
</Base>

<style>
  /* Avvo reviews: one full-width card per row; the text keeps a readable line length. */
  .reviews__head { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 12px 24px; flex-wrap: wrap; }
  .reviews__head h2 { margin: 0; }
  .reviews__link { font-weight: 650; text-decoration: none; }
  .reviews__link:hover { text-decoration: underline; }
  .reviews__list { display: grid; gap: 20px; }
  .reviews__list :global(.review) { padding: clamp(24px, 4vw, 40px) clamp(22px, 4vw, 48px); }
  .reviews__list :global(.review__title) { font-size: 1.3rem; }
  .reviews__list :global(blockquote) { max-width: 78ch; font-size: 1.1rem; line-height: 1.7; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; }
  .cta h2 { margin-bottom: 8px; }
  .cta p { margin: 0; color: var(--muted); max-width: 52ch; }
  .cta__actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
