---
// Every imported WordPress page and blog post lives at /<slug>/, as before.
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';
import Icon from '../components/Icon.astro';
import PracticeCarousel from '../components/PracticeCarousel.astro';
import LocationsNav from '../components/LocationsNav.astro';
import { firm } from '../site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = await getCollection('posts');
  return [
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, isPost: false } })),
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, isPost: true } })),
  ];
}

const { entry, isPost } = Astro.props;
const { Content } = await render(entry);
const kind = isPost ? 'post' : (entry.data as { kind: string }).kind;
const es = kind === 'es';
const lang = es ? 'es' : 'en';
const date = isPost ? (entry.data as { date: Date }).date : null;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const eyebrow = { practice: 'Practice area', location: 'Areas we serve', es: 'Abogados laborales', page: undefined, post: 'Blog' }[kind];
const crumbs = es
  ? [{ label: 'Inicio', href: '/' }, { label: 'Áreas de práctica', href: '/descripcion-general-de-las-areas-de-practica/' }]
  : isPost
    ? [{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }]
    : kind === 'practice'
      ? [{ label: 'Home', href: '/' }, { label: 'Practice areas', href: '/practice-areas-employment-law-overview/' }]
      : [{ label: 'Home', href: '/' }];
const pageData = isPost ? undefined : (entry.data as { hero?: ImageMetadata; heroPosition?: string });
const showSidebar = entry.id !== 'disclaimer';
const isOverview = entry.id === 'practice-areas-employment-law-overview';
// Spanish pages link to the Spanish practice pages in their own text instead.
const showCarousel = showSidebar && !es && !isOverview;
---
<Base title={entry.data.title} description={entry.data.description} lang={lang} type={isPost ? 'article' : 'website'}>
  <PageHero title={entry.data.title} eyebrow={eyebrow} crumbs={crumbs} image={pageData?.hero} imagePosition={pageData?.heroPosition}>
    {date && <p class="meta">{fmt(date)} · {firm.name}</p>}
  </PageHero>

  {isOverview && <PracticeCarousel eyebrow="Our practice areas" heading="Employment law for workers, start to finish." showEmployers />}

  <div class="wrap body" class:list={{ 'body--solo': !showSidebar }}>
    <article class="prose">
      <Content />
      {isPost && (
        <aside class="post-cta">
          <h2>Have a question about your rights at work?</h2>
          <p>Talk with an employment lawyer at {firm.name}. The consultation is free. Call <a href={firm.phoneHref}>{firm.phone}</a> or <a href="/contact-us/">send us a message</a>.</p>
          <p class="fine">This article is for general information and is not legal advice.</p>
        </aside>
      )}
    </article>

    {showSidebar && (
      <aside class="side">
        <div id="contact"><ConsultForm lang={lang} /></div>
        <a class="side__call" href={firm.phoneHref}>
          <Icon name="phone" />
          <span><small>{es ? 'O llámenos' : 'Prefer to talk? Call'}</small>{firm.phone}</span>
        </a>
        <LocationsNav lang={lang} />
      </aside>
    )}
  </div>

  {showCarousel && (
    <PracticeCarousel
      eyebrow={kind === 'practice' ? 'Other practice areas' : 'Practice areas'}
      heading={kind === 'location' ? 'What we handle for employees in your area.' : 'How we help employees.'}
      exclude={entry.id}
      tint
    />
  )}
</Base>

<style>
  .meta { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(40px, 6vw, 88px); padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(56px, 8vw, 104px); }
  .body--solo { grid-template-columns: minmax(0, 1fr); }
  .side { display: grid; gap: 16px; align-content: start; }
  #contact { scroll-margin-top: 100px; }
  .side__call { display: flex; align-items: center; gap: 14px; padding: 18px 22px; border-radius: 14px; background: var(--ink); color: #fff; text-decoration: none; font: 750 1.35rem/1.1 var(--display); }
  .side__call:hover { background: var(--blue); color: #fff; }
  .side__call small { display: block; font: 500 0.8rem/1.4 var(--body); color: #aab1bf; }
  .side__call:hover small { color: var(--blue-tint-2); }
  .side__call :global(svg) { width: 22px; height: 22px; }
  .post-cta { margin-top: 48px; padding: 28px; border-radius: 14px; background: var(--blue-tint); }
  .post-cta h2 { margin-top: 0 !important; font-size: 1.4rem; }
  .post-cta .fine { font-size: 0.82rem; color: var(--muted); margin: 0; }
  @media (max-width: 1000px) { .body { grid-template-columns: minmax(0, 1fr); } }
</style>
