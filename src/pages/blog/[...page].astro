---
// /blog/, /blog/2/ … The newest post is featured above the grid on page 1;
// the rest are paginated 12 to a page. Each page is indexable with its own
// canonical URL so Google keeps following links to older posts.
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BlogIndex from '../../components/BlogIndex.astro';
import { getPosts, POSTS_PER_PAGE } from '../../data/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const [featured, ...rest] = await getPosts();
  return paginate(rest, { pageSize: POSTS_PER_PAGE, props: { featured } });
}) satisfies GetStaticPaths;

const { page, featured } = Astro.props as { page: Page<CollectionEntry<'posts'>>; featured: CollectionEntry<'posts'> };
---
<BlogIndex page={page} featured={page.currentPage === 1 ? featured : undefined} />
