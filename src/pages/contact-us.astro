---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';
import Icon from '../components/Icon.astro';
import { firm } from '../site';
---
<Base title="Contact Us" description={`Contact ${firm.name} for a free employment law consultation. Call ${firm.phone}. Offices in Hauppauge and Manhattan.`}>
  <PageHero
    title="Get in touch"
    eyebrow="Free consultation"
    lede="Tell us what happened at work. We’ll listen, explain your options, and let you know honestly whether we can help."
    crumbs={[{ label: 'Home', href: '/' }]}
  />
  <div class="wrap section contact">
    <div class="contact__info">
      <a class="contact__phone" href={firm.phoneHref}><Icon name="phone" />{firm.phone}</a>
      <p>{firm.consultNote}</p>
      {firm.offices.map((o) => (
        <div class="contact__office">
          <Icon name="pin" />
          <div>
            <h2>{o.name}</h2>
            <p>{o.lines.map((l) => <>{l}<br /></>)}</p>
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.lines.join(', '))}`} rel="noopener" target="_blank">Get directions</a>
          </div>
        </div>
      ))}
      <div class="contact__office">
        <Icon name="globe" />
        <div>
          <h2>Se habla español</h2>
          <p>Our paralegal Angelica Villalba speaks Spanish. <a href="/descripcion-general-de-las-areas-de-practica/" lang="es">Información en español</a>.</p>
        </div>
      </div>
      <p class="contact__areas">We represent workers throughout New York City (Queens, Brooklyn, the Bronx and Manhattan), Nassau and Suffolk Counties, Westchester, Rockland and Orange Counties, and Northern New Jersey.</p>
    </div>
    <ConsultForm heading="Send us a message" />
  </div>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 88px); align-items: start; }
  .contact__phone { display: inline-flex; align-items: center; gap: 14px; font: 800 clamp(2rem, 4vw, 2.8rem)/1 var(--display); font-stretch: 112%; text-decoration: none; color: var(--ink); margin-bottom: 12px; }
  .contact__phone :global(svg) { width: 0.8em; height: 0.8em; color: var(--blue); }
  .contact__phone:hover { color: var(--blue); }
  .contact__office { display: flex; gap: 16px; padding: 24px 0; border-top: 1px solid var(--line); }
  .contact__office :global(svg) { width: 22px; height: 22px; color: var(--blue); flex: none; margin-top: 4px; }
  .contact__office h2 { font-size: 1.15rem; margin-bottom: 6px; }
  .contact__office p { margin-bottom: 6px; }
  .contact__areas { color: var(--muted); font-size: 0.95rem; border-top: 1px solid var(--line); padding-top: 24px; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
