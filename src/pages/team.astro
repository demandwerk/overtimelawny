---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { team, firm } from '../site';

const sectionIcon: Record<string, Parameters<typeof Icon>[0]['name']> = {
  Education: 'cap', Admitted: 'scale', Associations: 'users', Recognition: 'award', Publication: 'document',
};
type Credential = string | { name: string; detail?: string };
---
<Base title="Our Team" description={`Meet the employment lawyers of ${firm.name}: Peter A. Romero, David D. Barnhorn and Matthew J. Farnworth.`}>
  <PageHero
    title="Meet the team"
    eyebrow="Our team"
    lede="We practice employment law exclusively. Our attorneys treat clients with dignity, respect and compassion, and work to get the best result possible in the most cost-effective way."
    crumbs={[{ label: 'Home', href: '/' }]}
  />
  <div class="section">
    <div class="wrap">
      {team.map((m) => (
        <article class="member" id={m.initials.toLowerCase()}>
          <Image class="member__photo" src={m.photo} alt={`Photo of ${m.name}`} width={400} height={400} />
          <div>
            <p class="eyebrow">{m.role}</p>
            <h2>{m.name}</h2>
            {m.bio.map((p) => <p>{p}</p>)}
            {m.badges && (
              <p class="member__badges">
                {m.badges.map((b) => <a href={b.href} target="_blank" rel="noopener"><Image src={b.img} alt={b.alt} height={88} /></a>)}
              </p>
            )}
            {m.details.length > 0 && (
              <dl class="creds">
                {m.details.map((d) => (
                  <div class="creds__row">
                    <dt><Icon name={sectionIcon[d.label] ?? 'check'} />{d.label}</dt>
                    <dd>
                      {d.label === 'Admitted'
                        ? <ul class="creds__tags">{(d.items as Credential[]).map((i) => <li>{i as string}</li>)}</ul>
                        : <ul class="creds__list">{(d.items as Credential[]).map((i) => typeof i === 'string'
                            ? <li><strong>{i}</strong></li>
                            : <li><strong>{i.name}</strong>{i.detail && <span>{i.detail}</span>}</li>)}</ul>}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .member { display: grid; grid-template-columns: 300px 1fr; gap: clamp(28px, 5vw, 64px); padding: 56px 0; border-bottom: 1px solid var(--line); }
  .member:first-child { padding-top: 0; }
  .member:last-child { border-bottom: 0; padding-bottom: 0; }
  .member__photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 16px; position: sticky; top: 110px; background: var(--blue-tint); }
  .member p { max-width: 68ch; }
  .member__badges { display: flex; gap: 16px; flex-wrap: wrap; }
  .member__badges img { height: 80px; width: auto; }
  /* Credentials: one row per section, label on the left, entries on the right. */
  .creds { margin: 28px 0 0; padding: 6px 26px; background: var(--tint); border-radius: 14px; max-width: 760px; }
  .creds__row { display: grid; grid-template-columns: 170px 1fr; gap: 8px 24px; padding: 18px 0; }
  .creds__row + .creds__row { border-top: 1px solid var(--line); }
  .creds dt { display: flex; align-items: center; gap: 10px; align-self: start; padding-top: 2px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); }
  .creds dt :global(svg) { width: 18px; height: 18px; flex: none; }
  .creds dd { margin: 0; }
  .creds ul { margin: 0; padding: 0; list-style: none; }
  .creds__list li + li { margin-top: 12px; }
  .creds__list strong { display: block; font-weight: 600; color: var(--ink); line-height: 1.4; }
  .creds__list span { display: block; margin-top: 2px; font-size: 0.9rem; color: var(--muted); line-height: 1.45; }
  .creds__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .creds__tags li { padding: 6px 12px; border-radius: 10px; background: #fff; border: 1px solid var(--line); font-size: 0.85rem; font-weight: 500; color: var(--ink); }
  @media (max-width: 760px) {
    .member { grid-template-columns: 1fr; }
    .member__photo { position: static; max-width: 220px; }
    .creds { padding: 4px 18px; }
    .creds__row { grid-template-columns: 1fr; }
  }
</style>
