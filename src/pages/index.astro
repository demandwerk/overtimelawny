---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ConsultForm from '../components/ConsultForm.astro';
import Icon from '../components/Icon.astro';
import { firm, practiceAreas, testimonials, team, awards } from '../site';

const employeeAreas = practiceAreas.filter((p) => p.slug !== 'employer-defense');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const cases = [
  { tag: 'Disability discrimination', name: 'Corona v. Clarins U.S.A., Inc.', court: 'S.D.N.Y. 2019', text: 'Court denied the employer’s motion for summary judgment, allowing our client’s disability discrimination and retaliation claims to proceed to trial.' },
  { tag: 'Wage & hour class action', name: 'Castellanos v. Raymours Furniture Co.', court: 'E.D.N.Y. 2018', text: 'For delivery drivers and helpers, the court held an arbitration clause shortening the statute of limitations unenforceable.' },
  { tag: 'Appeal', name: 'Cohen v. State of New York', court: 'App. Div. 2015', text: 'On appeal, dismissal of our client’s disability claim was reversed. She was entitled to a jury trial.' },
];

const steps = [
  { n: '01', h: 'Free consultation', p: 'Call or send a message. We listen, ask the right questions and tell you honestly whether you have a case. Phone, Zoom or Teams.' },
  { n: '02', h: 'A clear plan', p: 'We explain the law, the strengths and weaknesses of your claim, and what to realistically expect at every stage.' },
  { n: '03', h: 'We fight for you', p: 'Negotiation, mediation, agency proceedings, trial or appeal. Whatever it takes to get you what you are owed.' },
];
---
<Base title={firm.name} description={`Employment lawyers for workers in New York City, Long Island and Northern New Jersey. Overtime, unpaid wages, discrimination, harassment and retaliation. Free consultation: ${firm.phone}.`}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Employment lawyers · NYC, Long Island &amp; NJ</p>
        <h1>When work turns unfair, <span class="hl">we fight back.</span></h1>
        <p class="lede">Romero Law Group represents employees in overtime, unpaid wage, discrimination, harassment and retaliation cases, and has for more than 20 years. Your first consultation is free.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={firm.phoneHref}><Icon name="phone" /> Call {firm.phone}</a>
          <a class="btn btn--ghost" href="#practice-areas">What we handle</a>
        </div>
        <ul class="hero__proof">
          <li><Icon name="check" /> Super Lawyers® recognized</li>
          <li><Icon name="check" /> Best Lawyers in America®</li>
          <li><Icon name="check" /> Se habla español</li>
        </ul>
      </div>
      <div class="hero__form">
        <ConsultForm />
      </div>
    </div>
  </section>

  <!-- Facts -->
  <section class="facts" aria-label="At a glance">
    <div class="wrap facts__grid">
      <div><strong>20+</strong><span>years practicing employment law exclusively</span></div>
      <div><strong>6 yrs</strong><span>of unpaid wages you can recover under New York law</span></div>
      <div><strong>NY &amp; NJ</strong><span>admitted in state and federal courts in both</span></div>
      <div><strong>$0</strong><span>to talk to us about your situation</span></div>
    </div>
  </section>

  <!-- Recognition -->
  <section class="awards" aria-label="Recognition">
    <div class="wrap awards__inner">
      <p class="awards__label">Recognized by peers and clients</p>
      <ul class="awards__list">
        {awards.map((a) => <li><a href={a.href} target="_blank" rel="noopener"><Image src={a.img} alt={a.alt} height={88} /></a></li>)}
      </ul>
    </div>
  </section>

  <!-- Practice areas -->
  <section class="section practice" id="practice-areas">
    <div class="wrap">
    <div class="section-head section-head--row">
      <div>
        <p class="eyebrow">Practice areas</p>
        <h2>Compassionate, aggressive legal help for employees facing unfair workplace conditions.</h2>
      </div>
      <div class="carousel__controls">
        <button type="button" class="carousel__btn" data-dir="-1" aria-label="Previous practice areas" disabled><Icon name="arrow" /></button>
        <button type="button" class="carousel__btn" data-dir="1" aria-label="Next practice areas"><Icon name="arrow" /></button>
      </div>
    </div>
    </div>
    <ul class="carousel" aria-label="Practice areas" tabindex="0">
      {employeeAreas.map((p) => (
        <li>
          <a class="area" href={`/${p.slug}/`}>
            <h3>{p.title}</h3>
            <p>{p.blurb}</p>
            <span class="area__more">Learn more <Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="wrap carousel__foot">
      <div class="carousel__progress" aria-hidden="true"><span></span></div>
      <p class="employers">Are you an employer? We also advise businesses on handbooks, policies and dispute resolution. <a href="/employer-defense/">Employer counsel →</a></p>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--dark">
    <div class="wrap why">
      <div class="why__intro">
        <p class="eyebrow">Why a boutique firm</p>
        <h2>You’re not a case number here.</h2>
        <p>We take the time to listen to your concerns and explain things clearly at the outset and at every stage. We return your calls, answer your questions, and give you an honest assessment of your case.</p>
        <p>We’ve also represented employers, so we know how the other side thinks, and which strategies and arguments actually work.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="steps__n">{s.n}</span>
            <div><h3>{s.h}</h3><p>{s.p}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Cases -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Representative cases</p>
          <h2>We stand tall against Goliath.</h2>
        </div>
        <a class="btn btn--ghost" href="/cases/">All cases</a>
      </div>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <p class="case__tag">{c.tag}</p>
            <h3>{c.name}</h3>
            <p class="case__court">{c.court}</p>
            <p>{c.text}</p>
          </article>
        ))}
      </div>
      <p class="fine">Prior results do not guarantee a similar outcome.</p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Client reviews</p>
        <h2>What our clients say.</h2>
      </div>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="quote">
            <Icon name="quote" />
            <p class="quote__stars" aria-label="5 out of 5 stars">★★★★★</p>
            <blockquote>{t.quote}</blockquote>
            <figcaption><strong>{t.name}</strong> · {t.detail}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Our team</p>
          <h2>Lawyers who only do employment law.</h2>
        </div>
        <a class="btn btn--ghost" href="/team/">Meet the team</a>
      </div>
      <ul class="people">
        {team.map((m) => (
          <li class="person">
            <Image class="person__photo" src={m.photo} alt={`Photo of ${m.name}`} width={400} height={400} />
            <h3>{m.name}</h3>
            <p>{m.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Serve + blog -->
  <section class="section section--tint">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2>Serving workers across the New York metro area.</h2>
        <ul class="places">
          <li><a href="/employment-law-attorneys-in-nassau-and-suffolk-counties-in-new-york/">Nassau &amp; Suffolk Counties</a></li>
          <li><a href="/new-jersey-nyc-overtime-wage-and-sexual-harassment-lawyers/">New York City</a></li>
          <li><a href="/new-jersey-nyc-overtime-wage-and-sexual-harassment-lawyers/">Northern New Jersey</a></li>
          <li><a href="/romero-law-group-expands-practice/">Westchester, Rockland &amp; Orange</a></li>
        </ul>
        <div class="offices">
          {firm.offices.map((o) => (
            <p><Icon name="pin" /><span><strong>{o.name}</strong><br />{o.lines.join(', ')}</span></p>
          ))}
          <p><Icon name="video" /><span><strong>Or meet virtually</strong><br />Phone, Zoom or Microsoft Teams</span></p>
        </div>
      </div>
      <div>
        <p class="eyebrow">From the blog</p>
        <h2>Know your rights.</h2>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <span>{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link-arrow" href="/blog/">All articles <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: clamp(40px, 7vw, 96px) 0 clamp(48px, 7vw, 96px); overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0 0 0 auto; width: 44%;
    background: linear-gradient(160deg, var(--blue) 0%, #1a2a55 100%);
    border-bottom-left-radius: 48px;
  }
  .hero__grid { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero h1 { margin-bottom: 24px; }
  .hl { color: var(--blue); }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 32px 0 28px; }
  .hero__proof { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; margin: 0; font-size: 0.92rem; font-weight: 550; color: var(--ink); }
  .hero__proof li { display: inline-flex; align-items: center; gap: 7px; }
  .hero__proof :global(svg) { width: 17px; height: 17px; color: var(--blue); stroke-width: 3; }
  @media (max-width: 980px) {
    .hero::before { width: 100%; top: auto; height: 46%; border-radius: 40px 40px 0 0; }
    .hero__grid { grid-template-columns: 1fr; }
  }

  .facts { border-block: 1px solid var(--line); }
  .facts__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .facts__grid > div { padding: 28px 24px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .facts__grid > div:first-child { border-left: 0; padding-left: 0; }
  .facts strong { font: 800 2.1rem/1 var(--display); font-stretch: 112%; color: var(--blue); }
  .facts span { color: var(--muted); font-size: 0.92rem; line-height: 1.4; }
  @media (max-width: 820px) {
    .facts__grid { grid-template-columns: 1fr 1fr; }
    .facts__grid > div { padding: 22px 16px; }
    .facts__grid > div:nth-child(odd) { border-left: 0; padding-left: 0; }
    .facts__grid > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  .awards { background: var(--tint); border-bottom: 1px solid var(--line); }
  .awards__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; padding-block: 24px; }
  .awards__label { margin: 0; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .awards__list { display: flex; align-items: center; gap: 16px 28px; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .awards__list a { display: block; transition: transform 0.15s; }
  .awards__list a:hover { transform: translateY(-2px); }
  .awards__list img { height: 76px; width: auto; }
  @media (max-width: 560px) { .awards__list img { height: 60px; } }

  /* Practice-area carousel: native horizontal scroll with snap, so it
     works with touch, trackpads and keyboards; buttons are a convenience. */
  .practice { overflow: hidden; }
  .carousel {
    --edge: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: flex; gap: 16px; list-style: none; margin: 0; padding: 4px var(--edge) 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .carousel::-webkit-scrollbar { display: none; }
  .carousel:focus-visible { outline-offset: -3px; }
  .carousel li { flex: 0 0 clamp(260px, 28vw, 340px); scroll-snap-align: start; display: flex; }
  .area {
    display: flex; flex-direction: column; width: 100%; min-height: 300px;
    padding: 30px 28px; border: 1px solid var(--line); border-radius: 16px;
    color: var(--text); text-decoration: none; background: #fff;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .area h3 { font-size: 1.45rem; margin-bottom: 14px; transition: color 0.2s; }
  .area p { color: var(--muted); font-size: 0.97rem; flex: 1; transition: color 0.2s; }
  .area__more { display: inline-flex; align-items: center; gap: 6px; font-weight: 650; font-size: 0.92rem; color: var(--blue); margin-top: 20px; }
  .area__more :global(svg) { width: 16px; height: 16px; transition: transform 0.15s; }
  .area:hover, .area:focus-visible { background: var(--blue); border-color: var(--blue); color: #fff; transform: translateY(-3px); }
  .area:hover h3, .area:focus-visible h3, .area:hover .area__more, .area:focus-visible .area__more { color: #fff; }
  .area:hover p, .area:focus-visible p { color: rgb(255 255 255 / 80%); }
  .area:hover .area__more :global(svg) { transform: translateX(4px); }

  .practice .section-head--row h2 { max-width: 30ch; }
  .carousel__controls { display: flex; gap: 10px; }
  .carousel__btn {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    border: 2px solid var(--ink); background: #fff; color: var(--ink); cursor: pointer; transition: 0.15s;
  }
  .carousel__btn[data-dir='-1'] :global(svg) { transform: rotate(180deg); }
  .carousel__btn :global(svg) { width: 20px; height: 20px; }
  .carousel__btn:hover:not(:disabled) { background: var(--ink); color: #fff; }
  .carousel__btn:disabled { opacity: 0.3; cursor: default; }
  .carousel__foot { margin-top: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px 40px; flex-wrap: wrap; }
  .carousel__progress { flex: 1 1 240px; max-width: 420px; height: 3px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .carousel__progress span { display: block; height: 100%; width: 25%; background: var(--blue); border-radius: 3px; transform-origin: left; transition: margin-left 0.1s linear; }
  .employers { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .employers a { font-weight: 650; }
  @media (max-width: 720px) { .carousel__controls { display: none; } .area { min-height: 260px; } }
  @media (prefers-reduced-motion: reduce) { .carousel { scroll-behavior: auto; } .area { transition: none; } }

  .why { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); align-items: start; }
  .why__intro p { font-size: 1.08rem; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .steps li { display: flex; gap: 22px; padding: 26px; border-radius: 14px; background: var(--ink-2); border: 1px solid #252a33; }
  .steps__n { font: 800 1.6rem/1 var(--display); font-stretch: 112%; color: var(--blue-on-dark); }
  .steps h3 { margin-bottom: 6px; }
  .steps p { margin: 0; font-size: 0.97rem; }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr; } }

  .section-head--row { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .section-head--row h2 { margin: 0; }

  .cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .case { padding: 28px; border-radius: 14px; background: var(--tint); border-top: 4px solid var(--blue); }
  .case__tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin-bottom: 14px; }
  .case h3 { font-size: 1.15rem; margin-bottom: 4px; }
  .case__court { font-size: 0.85rem; color: var(--muted); font-style: italic; }
  .case p:last-child { margin: 0; font-size: 0.97rem; }
  .fine { font-size: 0.82rem; color: var(--muted); margin: 18px 0 0; }
  @media (max-width: 860px) { .cases { grid-template-columns: 1fr; } }

  .quotes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .quote { margin: 0; padding: 32px; background: #fff; border-radius: 14px; border: 1px solid var(--line); position: relative; }
  .quote > :global(svg) { position: absolute; top: 28px; right: 28px; width: 34px; height: 34px; color: var(--blue-tint); fill: var(--blue-tint); }
  .quote__stars { color: var(--blue); letter-spacing: 3px; margin-bottom: 12px; }
  .quote blockquote { margin: 0 0 18px; font-size: 1.08rem; line-height: 1.6; color: var(--ink); }
  .quote figcaption { font-size: 0.9rem; color: var(--muted); }
  .quote figcaption strong { color: var(--ink); }
  @media (max-width: 760px) { .quotes { grid-template-columns: 1fr; } }

  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .person__photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 14px; margin-bottom: 16px; background: var(--blue-tint); }
  .person h3 { font-size: 1.15rem; margin-bottom: 2px; }
  .person p { color: var(--muted); font-size: 0.92rem; margin: 0; }
  @media (max-width: 860px) { .people { grid-template-columns: 1fr 1fr; } }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  .places { list-style: none; padding: 0; margin: 24px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .places a { display: block; padding: 14px 16px; background: #fff; border: 1px solid var(--line); border-radius: 10px; font-weight: 600; text-decoration: none; color: var(--ink); font-size: 0.95rem; }
  .places a:hover { border-color: var(--blue); color: var(--blue); }
  @media (max-width: 480px) { .places { grid-template-columns: 1fr; } }
  .offices p { display: flex; gap: 12px; font-size: 0.95rem; margin-bottom: 14px; }
  .offices :global(svg) { width: 20px; height: 20px; color: var(--blue); flex: none; margin-top: 3px; }
  .offices strong { color: var(--ink); }
  .posts { list-style: none; padding: 0; margin: 24px 0; }
  .posts a { display: flex; flex-direction: column; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .posts li:first-child a { border-top: 1px solid var(--line); }
  .posts time { font-size: 0.8rem; color: var(--muted); }
  .posts span { font: 700 1.1rem/1.3 var(--display); color: var(--ink); }
  .posts a:hover span { color: var(--blue); }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; font-weight: 650; text-decoration: none; }
  .link-arrow :global(svg) { width: 16px; height: 16px; }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.carousel');
  if (track) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.carousel__btn');
    const bar = document.querySelector<HTMLElement>('.carousel__progress span')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const visible = track.clientWidth / track.scrollWidth;
      bar.style.width = `${visible * 100}%`;
      bar.style.marginLeft = `${max > 0 ? (track.scrollLeft / max) * (1 - visible) * 100 : 0}%`;
      buttons[0].disabled = track.scrollLeft <= 4;
      buttons[1].disabled = track.scrollLeft >= max - 4;
    };
    buttons.forEach((b) => b.addEventListener('click', () => {
      const card = track.querySelector('li')!.getBoundingClientRect().width + 16;
      const step = Math.max(card, Math.floor(track.clientWidth / card - 0.2) * card);
      track.scrollBy({ left: Number(b.dataset.dir) * step, behavior: reduce ? 'auto' : 'smooth' });
    }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
