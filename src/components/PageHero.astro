---
// Page title banner over a navy-tinted photo. Pass `image` to use a different
// photo on a page; the Manhattan skyline is the default.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manhattan from '../assets/hero/manhattan.jpg';

interface Props { title: string; eyebrow?: string; lede?: string; crumbs?: { label: string; href: string }[]; image?: ImageMetadata; imagePosition?: string }
const { title, eyebrow, lede, crumbs = [], image = manhattan, imagePosition = '50% 35%' } = Astro.props;
---
<section class="phero">
  <Image class="phero__bg" src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" style={`object-position: ${imagePosition}`} />
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={c.href}>{c.label}</a></>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; isolation: isolate; overflow: hidden; background: var(--blue); color: #fff; padding: clamp(48px, 7vw, 96px) 0 clamp(44px, 6vw, 80px); }
  .phero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .phero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(26 42 85 / 95%) 0%, rgb(37 58 113 / 85%) 50%, rgb(37 58 113 / 60%) 100%);
  }
  .phero h1 { color: #fff; font-size: clamp(2.1rem, 4.6vw, 3.6rem); max-width: 22ch; margin-bottom: 16px; }
  .phero .eyebrow { color: var(--blue-on-dark); }
  .phero .lede, .phero :global(.meta) { margin: 0; color: rgb(255 255 255 / 85%); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; margin-bottom: 20px; color: rgb(255 255 255 / 60%); }
  .crumbs a { color: rgb(255 255 255 / 80%); text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
  .phero :global(.btn--primary) { background: #fff; color: var(--blue); }
</style>
