---
interface Props { title: string; eyebrow?: string; lede?: string; crumbs?: { label: string; href: string }[] }
const { title, eyebrow, lede, crumbs = [] } = Astro.props;
---
<section class="phero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={c.href}>{c.label}</a></>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { background: var(--tint); border-bottom: 1px solid var(--line); padding: clamp(40px, 6vw, 80px) 0 clamp(36px, 5vw, 64px); position: relative; overflow: hidden; }
  .phero::after { content: ''; position: absolute; right: -80px; top: -80px; width: 320px; height: 320px; border-radius: 50%; border: 56px solid var(--blue); opacity: 0.08; }
  .phero h1 { font-size: clamp(2.1rem, 4.6vw, 3.6rem); max-width: 22ch; margin-bottom: 16px; }
  .phero .lede { margin: 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; margin-bottom: 20px; color: var(--muted); }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--blue); text-decoration: underline; }
</style>
