---
// "Practice areas" box under "Where we practice": every practice-area page,
// each with its icon. On Spanish pages names are in Spanish and link to the
// Spanish version where one exists.
import Icon from './Icon.astro';
import { practiceAreas, practiceHref, practiceOverview, spanishHome, translations } from '../site';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const path = Astro.url.pathname;
const hrefFor = (slug: string) => {
  const en = practiceHref(slug);
  return es ? translations[en] ?? en : en;
};
---
<nav class="areas" aria-label={es ? 'Áreas de práctica' : 'Practice areas'}>
  <h2>{es ? 'Áreas de práctica' : 'Practice areas'}</h2>
  <ul>
    {practiceAreas.map((p) => {
      const href = hrefFor(p.slug);
      return (
        <li>
          <a href={href} aria-current={path === href ? 'page' : undefined}>
            <Icon name={p.icon as Parameters<typeof Icon>[0]['name']} />
            <span>{es ? p.titleEs : p.title}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <a class="areas__all" href={es ? spanishHome : practiceOverview}>{es ? 'Ver todas' : 'All practice areas'} →</a>
</nav>

<style>
  .areas { padding: 22px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
  .areas h2 { font: 700 0.8rem/1 var(--body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .areas ul { list-style: none; margin: 0; padding: 0; }
  .areas li + li { border-top: 1px solid var(--line); }
  .areas ul a { display: flex; align-items: center; gap: 12px; padding: 10px 8px; margin: 0 -8px; border-radius: 8px; text-decoration: none; color: var(--ink); font: 650 0.95rem/1.3 var(--body); }
  .areas ul a:hover { background: var(--blue-tint); }
  .areas ul a[aria-current='page'] { background: var(--blue); color: #fff; }
  .areas :global(svg) { width: 18px; height: 18px; flex: none; color: var(--blue); }
  .areas a[aria-current='page'] :global(svg) { color: #fff; }
  .areas__all { display: inline-block; margin-top: 12px; font-weight: 650; font-size: 0.9rem; text-decoration: none; }
  .areas__all:hover { text-decoration: underline; }
</style>
