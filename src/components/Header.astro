---
import { firm, nav, spanishHome } from '../site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo.png';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;
---
<div class="topbar">
  <div class="wrap topbar__inner">
    <span class="topbar__regions">{firm.regions}</span>
    <span class="topbar__links">
      {lang === 'en'
        ? <a href={spanishHome} lang="es">Se habla español</a>
        : <a href="/" lang="en">English</a>}
      <a href={firm.phoneHref} class="topbar__phone"><Icon name="phone" /> {firm.phone}</a>
    </span>
  </div>
</div>

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo" aria-label={`${firm.name}, home`}>
      <Image src={logo} alt={firm.name} class="logo__img" height={112} loading="eager" />
    </a>

    <details class="menu" open>
      <summary class="menu__toggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <nav class="nav" aria-label="Main">
        <ul class="nav__list">
          {nav.map((item) => item.children ? (
            <li class="nav__item nav__item--parent">
              <button type="button" class="nav__link" aria-haspopup="true" aria-expanded="false">
                {item.label} <Icon name="chevron" />
              </button>
              <ul class="nav__sub" class:list={{ 'nav__sub--wide': item.children.length > 6 }}>
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="nav__item">
              <a class="nav__link" href={item.href} aria-current={isActive(item.href!) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <a href="/contact-us/" class="btn btn--primary nav__cta">
          {lang === 'es' ? 'Consulta gratuita' : 'Free consultation'}
        </a>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  // The menu is a <details>: always open on desktop, a toggle on mobile.
  // Runs inline so the nav never flashes in the wrong state.
  (() => {
    const menu = document.querySelector('.menu');
    const mq = window.matchMedia('(min-width: 981px)');
    const sync = () => { menu.open = mq.matches; };
    sync();
    mq.addEventListener('change', sync);

    // On phones, each dropdown opens and closes with a tap.
    for (const btn of menu.querySelectorAll('.nav__item--parent > .nav__link')) {
      btn.addEventListener('click', () => {
        if (mq.matches) return;
        const open = btn.parentElement.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    }
  })();
</script>

<style>
  .topbar { background: var(--ink); color: #aab1bf; font-size: 0.85rem; }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; min-height: 40px; gap: 16px; }
  .topbar__links { display: flex; gap: 22px; align-items: center; margin-left: auto; }
  .topbar a { color: #fff; text-decoration: none; font-weight: 550; }
  .topbar a:hover { color: var(--blue-on-dark); }
  .topbar__phone { display: inline-flex; align-items: center; gap: 6px; }
  .topbar__phone :global(svg) { width: 14px; height: 14px; }
  @media (max-width: 720px) { .topbar__regions { display: none; } .topbar__links { margin: 0 auto; } }

  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 94%);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 76px; gap: 24px; }

  .logo { display: flex; align-items: center; }
  .logo__img { height: 56px; width: auto; }
  @media (max-width: 420px) { .logo__img { height: 46px; } }

  .menu__toggle { display: none; }
  .nav { display: flex; align-items: center; gap: 12px; }
  .nav__list { display: flex; list-style: none; margin: 0; padding: 0; gap: 2px; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 10px 12px; border: 0; background: none; border-radius: 6px;
    font: 550 0.97rem/1 var(--body); color: var(--text); text-decoration: none; cursor: pointer;
  }
  .nav__link:hover, .nav__link[aria-current='page'] { color: var(--blue); }
  .nav__link :global(svg) { width: 14px; height: 14px; }
  .nav__sub {
    position: absolute; top: 100%; left: 0; min-width: 250px;
    list-style: none; margin: 0; padding: 8px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: 0.15s;
  }
  .nav__item--parent:hover .nav__sub, .nav__item--parent:focus-within .nav__sub { opacity: 1; visibility: visible; transform: none; }
  .nav__sub--wide { display: grid; grid-template-columns: 1fr 1fr; gap: 0 4px; min-width: 520px; }
  .nav__sub--wide li:first-child { grid-column: 1 / -1; border-bottom: 1px solid var(--line); margin-bottom: 6px; padding-bottom: 6px; }
  .nav__sub--wide li:first-child a { font-weight: 650; color: var(--blue); }
  .nav__sub a { display: block; padding: 10px 12px; border-radius: 6px; color: var(--text); text-decoration: none; font-size: 0.95rem; }
  .nav__sub a:hover { background: var(--blue-tint); color: var(--blue); }
  .nav__cta { min-height: 44px; padding: 0 20px; font-size: 0.95rem; margin-left: 8px; }


  @media (max-width: 980px) {
    .menu__toggle {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 46px; height: 46px; padding: 0 11px; border-radius: 8px; cursor: pointer; list-style: none;
    }
    .menu__toggle::-webkit-details-marker { display: none; }
    .menu__toggle span { height: 2px; background: var(--ink); border-radius: 2px; transition: 0.2s; }
    .menu[open] .menu__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu[open] .menu__toggle span:nth-child(2) { opacity: 0; }
    .menu[open] .menu__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .nav {
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 8px var(--gutter) 24px; background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
      max-height: calc(100vh - 116px); overflow-y: auto;
    }
    .nav__list { flex-direction: column; }
    .nav__link { width: 100%; padding: 14px 0; font-size: 1.05rem; border-bottom: 1px solid var(--line); border-radius: 0; }
    .nav__item--parent .nav__link { justify-content: space-between; }
    .nav__item--parent .nav__link :global(svg) { width: 18px; height: 18px; transition: transform 0.2s; }
    .nav__item--parent.is-open .nav__link :global(svg) { transform: rotate(180deg); }
    .nav__item--parent:not(.is-open) .nav__sub { display: none; }
    .nav__sub { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0 0 8px; border-bottom: 1px solid var(--line); border-radius: 0; }
    .nav__sub a { padding: 10px 0; font-size: 1.05rem; }
    .nav__sub--wide { display: block; min-width: 0; }
    .nav__sub--wide li:first-child { margin-bottom: 0; padding-bottom: 0; border: 0; }
    .nav__cta { margin: 20px 0 0; }
  }
</style>
