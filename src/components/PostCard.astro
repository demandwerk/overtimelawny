---
// Blog post card: image (or a navy placeholder with the topic's icon), date and
// read time, title, summary and a "Read more" link.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { topicBySlug } from '../data/topics';
import { formatDate, postHref, readMinutes } from '../data/blog';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const topic = topicBySlug[post.data.topic];
const href = postHref(post.id);
---
<article class="card">
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    {post.data.image
      ? <Image src={post.data.image} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 380px" />
      : <span class="card__placeholder"><Icon name={topic.icon as Parameters<typeof Icon>[0]['name']} /></span>}
    <span class="card__topic">{topic.title}</span>
  </a>
  <div class="card__body">
    <p class="card__meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readMinutes(post.body)} min read</p>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p class="card__text">{post.data.description}</p>
    <a class="card__more" href={href} aria-label={`Read more: ${post.data.title}`}>Read more →</a>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: 0 1px 2px rgb(13 16 20 / 4%); transition: box-shadow 0.2s, transform 0.2s; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  .card__media { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--blue); overflow: hidden; }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .card__placeholder { display: grid; place-items: center; width: 100%; height: 100%; background: linear-gradient(135deg, var(--blue) 0%, var(--navy) 100%); color: rgb(255 255 255 / 85%); }
  .card__placeholder :global(svg) { width: 54px; height: 54px; stroke-width: 1.5; }
  .card__topic { position: absolute; left: 14px; top: 14px; padding: 5px 10px; border-radius: 999px; background: rgb(255 255 255 / 92%); color: var(--blue); font: 700 0.72rem/1 var(--body); letter-spacing: 0.04em; }
  .card__body { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 22px; }
  .card__meta { margin: 0 0 8px; font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .card h3 { font-size: 1.12rem; line-height: 1.3; margin: 0 0 10px; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card h3 a:hover { color: var(--blue); }
  .card__text { flex: 1; margin: 0 0 16px; color: var(--muted); font-size: 0.92rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__more { align-self: flex-start; font-weight: 650; font-size: 0.9rem; text-decoration: none; }
  .card__more:hover { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
