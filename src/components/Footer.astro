---
import { firm, practiceAreas, practiceHref, practiceOverview, spanishHome } from '../site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import shield from '../assets/shield.png';
import wordmark from '../assets/logo-text-white.png';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const year = new Date().getFullYear();
const directions = (lines: string[]) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(lines.join(', '))}`;
---
<section class="cta-band">
  <div class="wrap cta-band__inner">
    <div>
      <h2>{es ? '¿Le trataron injustamente en el trabajo?' : 'Treated unfairly at work?'}</h2>
      <p>{es ? 'Hable con un abogado laboral hoy. La consulta es gratuita.' : 'Talk to an employment lawyer today. Your consultation is free.'}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--light" href={firm.phoneHref}><Icon name="phone" /> {firm.phone}</a>
      <a class="btn btn--outline-light" href="/contact-us/">{es ? 'Escríbanos' : 'Send us a message'}</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap offices">
    <h3>{es ? 'Nuestras oficinas' : 'Our offices'}</h3>
    <div class="offices__grid">
      {firm.offices.map((o) => (
        <article class="office">
          <Image class="office__photo" src={o.photo} alt="" widths={[600, 900]} sizes="(max-width: 720px) 100vw, 580px" />
          <h4>{o.city}</h4>
          <p>{o.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
          <a href={directions(o.lines)} target="_blank" rel="noopener">{es ? 'Cómo llegar' : 'Get directions'}</a>
        </article>
      ))}
    </div>
  </div>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <p class="footer__logo">
        <Image src={shield} alt="" height={128} />
        <Image src={wordmark} alt={firm.name} height={128} />
      </p>
      <p>{es ? 'Defendiendo los derechos de los trabajadores por más de 20 años.' : 'Protecting the rights of workers for more than 20 years.'}</p>
      <a class="footer__phone" href={firm.phoneHref}>{firm.phone}</a>
      <p class="footer__muted">{firm.consultNote}</p>
    </div>
    <div>
      <h3>{es ? 'Áreas de práctica' : 'Practice areas'}</h3>
      <ul>
        {practiceAreas.slice(0, 7).map((p) => <li><a href={practiceHref(p.slug)}>{p.title}</a></li>)}
        <li><a href={practiceOverview}>{es ? 'Ver todas' : 'View all'} →</a></li>
      </ul>
    </div>
    <div>
      <h3>{es ? 'El bufete' : 'The firm'}</h3>
      <ul>
        <li><a href="/team/">{es ? 'Equipo' : 'Our team'}</a></li>
        <li><a href="/cases/">{es ? 'Casos representativos' : 'Representative cases'}</a></li>
        <li><a href="/current-lawsuits/">{es ? 'Demandas actuales' : 'Current lawsuits'}</a></li>
        <li><a href="/testimonials/">{es ? 'Testimonios' : 'Client testimonials'}</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contact-us/">{es ? 'Contacto' : 'Contact'}</a></li>
        <li><a href={spanishHome} lang="es">Español</a></li>
      </ul>
    </div>
  </div>
  <nav class="wrap footer__links" aria-label={es ? 'Enlaces legales e información' : 'Legal and site information'}>
    <a href="/disclaimer/">Disclaimer</a>
    <a href="/llm-ai-agent-info/">LLMs, Learn About Us Here</a>
  </nav>
  <div class="wrap footer__bottom">
    <p>© {year} {firm.name}. Attorney advertising. Prior results do not guarantee a similar outcome.</p>
    <p class="footer__social">
      {firm.social.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.name}</a>)}
    </p>
  </div>
</footer>

<a class="callbar" href={firm.phoneHref}>
  <Icon name="phone" /> {es ? 'Llame ahora' : 'Call now'} · {firm.phone}
</a>

<style>
  .cta-band { background: var(--blue); color: #fff; padding: clamp(40px, 6vw, 64px) 0; }
  .cta-band__inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .cta-band h2 { color: #fff; margin-bottom: 6px; }
  .cta-band p { margin: 0; color: rgb(255 255 255 / 85%); font-size: 1.1rem; }
  .cta-band__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn--light { background: #fff; color: var(--blue); }
  .btn--light:hover { background: var(--ink); color: #fff; }
  .btn--outline-light { border-color: rgb(255 255 255 / 60%); color: #fff; }
  .btn--outline-light:hover { background: #fff; color: var(--blue); border-color: #fff; }

  .footer { background: var(--ink); color: #9aa2b1; font-size: 0.95rem; padding: 64px 0 0; }
  .footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 0.8fr; gap: 40px; }
  .footer h3 { color: #fff; font-size: 0.8rem; font-family: var(--body); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li { margin-bottom: 8px; }
  .footer a { color: #d6dae2; text-decoration: none; }
  .footer a:hover { color: #fff; text-decoration: underline; }
  .footer__logo { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .footer__logo img { height: 64px; width: auto; }
  .footer__name { font: 800 1.35rem/1.2 var(--display); font-stretch: 112%; color: #fff; margin-bottom: 8px; }
  .footer__phone { display: inline-block; font: 750 1.5rem/1 var(--display); color: #fff !important; margin: 6px 0 12px; }
  .footer__muted { font-size: 0.85rem; color: #7d8594; }

  /* Office cards: photo under a navy overlay, city, accent rule, address, directions. */
  .offices { padding-bottom: 48px; margin-bottom: 48px; border-bottom: 1px solid #262b34; }
  .offices__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .office { position: relative; isolation: isolate; overflow: hidden; min-height: 240px; padding: 32px; border-radius: 14px; border: 1px solid rgb(255 255 255 / 12%); display: flex; flex-direction: column; justify-content: flex-end; }
  .office :global(.office__photo) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .office::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(26 42 85 / 88%) 0%, rgb(26 42 85 / 62%) 55%, rgb(26 42 85 / 30%) 100%); }
  .office:hover :global(.office__photo) { transform: scale(1.04); }
  .office h4 { color: #fff; font: 800 clamp(1.6rem, 3vw, 2.1rem)/1.1 var(--display); margin: 0 0 14px; }
  .office h4::after { content: ''; display: block; width: 56px; height: 3px; margin-top: 14px; border-radius: 2px; background: var(--blue-on-dark); }
  .office p { margin: 0 0 18px; color: rgb(255 255 255 / 88%); font-size: 1rem; line-height: 1.5; }
  .office a { align-self: flex-start; color: #fff; font-weight: 650; text-decoration: none; border-bottom: 2px solid var(--blue-on-dark); padding-bottom: 2px; }
  .office a:hover { color: #fff; border-color: #fff; text-decoration: none; }
  @media (max-width: 720px) { .offices__grid { grid-template-columns: 1fr; } .office { min-height: 210px; padding: 26px; } }
  .footer__links { display: flex; flex-wrap: wrap; gap: 8px 28px; border-top: 1px solid #262b34; margin-top: 48px; padding-top: 18px; padding-bottom: 18px; font-size: 0.85rem; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid #262b34; padding-top: 24px; padding-bottom: 32px; font-size: 0.82rem; color: #7d8594; }
  .footer__bottom p { margin: 0; }
  .footer__social { display: flex; gap: 18px; flex-wrap: wrap; }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; } }

  /* Sticky click-to-call on phones. */
  .callbar { display: none; }
  @media (max-width: 720px) {
    .callbar {
      position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 60;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 54px; border-radius: 999px; background: var(--blue); color: #fff;
      font-weight: 700; text-decoration: none; box-shadow: 0 10px 30px rgb(13 16 20 / 30%);
    }
    .callbar :global(svg) { width: 18px; height: 18px; }
    .footer { padding-bottom: 80px; }
  }
</style>
