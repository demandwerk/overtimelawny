---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/hero/manhattan.jpg';
import { firm, translations } from '../site';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: ImageMetadata; // social-share picture; the Manhattan skyline otherwise
}
const { title, description = `${firm.name}: employment lawyers for workers in ${firm.regions}. Free consultation: ${firm.phone}.`, lang = 'en', type = 'website', noindex = false, image = defaultShareImage } = Astro.props;
const shareImage = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpeg' });
const shareImageUrl = new URL(shareImage.src, Astro.site);
// Search results show about 60 characters, so the brand is added only when it fits.
const branded = `${title} | ${firm.shortName}`;
const fullTitle = title === firm.name || branded.length > 60 ? title : branded;
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang pair for pages that have a translation (English is the default).
const enPath = Object.entries(translations).find(([en, es]) => Astro.url.pathname === en || Astro.url.pathname === es)?.[0];
const alternates = enPath && { en: new URL(enPath, Astro.site), es: new URL(translations[enPath], Astro.site) };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: firm.name,
  url: Astro.site?.href,
  telephone: '+1-631-257-5588',
  areaServed: ['New York City', 'Long Island', 'Nassau County', 'Suffolk County', 'Westchester County', 'New Jersey'],
  address: firm.offices.map((o) => ({
    '@type': 'PostalAddress',
    streetAddress: o.lines[0],
    addressLocality: o.lines[1].split(',')[0],
    addressRegion: 'NY',
    postalCode: o.lines[1].match(/\d{5}/)?.[0],
  })),
  knowsLanguage: ['en', 'es'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates && <link rel="alternate" hreflang="es" href={alternates.es} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.en} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={firm.name} />
    <meta property="og:image" content={shareImageUrl} />
    <meta name="theme-color" content="#253a71" />
    <!-- Google tag (gtag.js) — GA4 + Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EZWWT48L1P" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EZWWT48L1P');
      gtag('config', 'AW-18059846050');
    </script>
    <!-- UserWay accessibility widget -->
    <script src="https://cdn.userway.org/widget.js" data-account="FrHUKxOTwO" is:inline></script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header lang={lang} alt={alternates ? (lang === 'es' ? alternates.en.pathname : alternates.es.pathname) : undefined} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script src="https://s.ksrndkehqnwntyxlhgto.com/165667.js" is:inline></script>
    <script is:inline>
      (function(ng,a,g,e,l,i,ve){l=a.createElement(g),l.async=1,l.src=ng+e;var c=a.getElementsByTagName(g)[0];c.parentNode.insertBefore(l,c);var i=a.createElement('div');var ve='style';i.id='nGageLH',i[ve].position='fixed',i[ve].right='0px',i[ve].bottom='0px',i[ve].zIndex='5000',a.body&&a.body.appendChild(i);}('https://messenger.ngageics.com/ilnksrvr.aspx?websiteid=',document,'script','108-90-184-63-228-165-167-175'));
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--blue); color: #fff; padding: 10px 16px; border-radius: 6px; }
  .skip:focus { left: 8px; }
</style>
